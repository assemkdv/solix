include tests/fixtures/*.csv tests/fixtures/*.md
recursive-include examples *.py *.csv *.txt *.json *.md *.fits
recursive-include docs *.py *.pdf *.png *.md
prune src/solix.egg-info
# Never ship generated example outputs, the downloaded image cache,
# partial downloads or byte code.
prune examples/output
prune examples/real_data/images
# Local folders that are not part of the project.
prune meetings
global-exclude __pycache__ *.py[cod] *.part .DS_Store
