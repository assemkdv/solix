<mxfile host="flare-indexer build_diagrams.py"><diagram id="page1" name="1 Overview"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;flare-indexer: components and data flow&lt;/b&gt;&lt;br&gt;&lt;i&gt;Real inputs -&amp;gt; loaders -&amp;gt; CSV inputs -&amp;gt; DatasetBuilder -&amp;gt; EventMatcher -&amp;gt; strategy -&amp;gt; labeled table&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="raw_img" value="HMI image list&lt;br&gt;(headerless paths, e.g.&lt;br&gt;totalfiles_jpg_512.csv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="110.0" width="200.0" height="90.0" as="geometry"/></mxCell><mxCell id="raw_cat" value="GOES catalog&lt;br&gt;(goes_flares_integrated.csv:&lt;br&gt;start/peak/end_time, goes_class,&lt;br&gt;noaa_active_region)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="400.0" width="200.0" height="90.0" as="geometry"/></mxCell><mxCell id="load_img" value="loaders.&lt;br&gt;build_image_index_from_filenames()&lt;br&gt;parse HMI.m...jpg file names;&lt;br&gt;strict, duplicate_policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260.0" y="110.0" width="250.0" height="90.0" as="geometry"/></mxCell><mxCell id="load_cat" value="loaders.adapt_goes_catalog()&lt;br&gt;keep full timestamps,&lt;br&gt;normalize noaa_active_region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260.0" y="400.0" width="250.0" height="90.0" as="geometry"/></mxCell><mxCell id="img_rep" value="ImageIndexReport&lt;br&gt;(excluded rows, duplicates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260.0" y="230.0" width="250.0" height="50.0" as="geometry"/></mxCell><mxCell id="idx" value="Image index CSV&lt;br&gt;timestamp [, active_region]&lt;br&gt;[, image_path, ...]&lt;br&gt;(or written by hand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="540.0" y="110.0" width="200.0" height="90.0" as="geometry"/></mxCell><mxCell id="cat" value="Flare catalog CSV&lt;br&gt;start_time, peak_time,&lt;br&gt;end_time, class, active_region&lt;br&gt;(or HHMM scraper schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="540.0" y="400.0" width="200.0" height="90.0" as="geometry"/></mxCell><mxCell id="builder" value="&lt;b&gt;builder.DatasetBuilder&lt;/b&gt;&lt;br&gt;__init__: validate parameters; choose mode (single image,&lt;br&gt;row-based or time-based sequences) and target&lt;br&gt;build(index, catalog): read and check the index, loop over&lt;br&gt;reference times t, collect records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="100.0" width="370.0" height="120.0" as="geometry"/></mxCell><mxCell id="matcher" value="&lt;b&gt;events.EventMatcher&lt;/b&gt;&lt;br&gt;load catalog, detect schema, validate GOES classes, sort&lt;br&gt;query(t, prediction_window, active_region,&lt;br&gt;event_time, interval_mode) -&amp;gt; list[FlareEvent]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="290.0" width="370.0" height="110.0" as="geometry"/></mxCell><mxCell id="strategy" value="&lt;b&gt;Strategy&lt;/b&gt;&lt;br&gt;label(flares)&lt;br&gt;BinaryThreshold-&lt;br&gt;Strategy(&quot;M&quot;)&lt;br&gt;MaxFlareStrategy()&lt;br&gt;DatasetBuilding-&lt;br&gt;Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="470.0" width="180.0" height="130.0" as="geometry"/></mxCell><mxCell id="reducer" value="MaxFluxReducer&lt;br&gt;flares -&amp;gt; max flux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="980.0" y="470.0" width="160.0" height="60.0" as="geometry"/></mxCell><mxCell id="labeler" value="BinaryThresholdLabeler&lt;br&gt;/ RegressionLabeler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="980.0" y="560.0" width="160.0" height="60.0" as="geometry"/></mxCell><mxCell id="flux" value="FluxConverter&lt;br&gt;&quot;M2.3&quot; -&amp;gt; 2.3e-5 W/m^2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="980.0" y="650.0" width="160.0" height="60.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;DataFrame&lt;/b&gt;&lt;br&gt;one row per image&lt;br&gt;or sequence; label +&lt;br&gt;requested metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="660.0" width="180.0" height="120.0" as="geometry"/></mxCell><mxCell id="report" value="Also returned/raised:&lt;br&gt;SequenceBuildReport&lt;br&gt;(time-based mode)&lt;br&gt;UserWarning (missing&lt;br&gt;active regions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="540.0" y="660.0" width="200.0" height="120.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="raw_img" target="load_img"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="raw_cat" target="load_cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="writes" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="load_img" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="writes" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="load_cat" target="cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="load_img" target="img_rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="idx" target="builder"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="cat" target="matcher"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="each t" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="builder" target="matcher"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="flares" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="matcher" target="strategy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="strategy" target="reducer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="value" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="reducer" target="labeler"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="uses" style="endArrow=block;html=1;rounded=1;fontSize=10;dashed=1;" edge="1" parent="1" source="labeler" target="flux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="label" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="strategy" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;dashed=1;" edge="1" parent="1" source="out" target="report"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 build() flow"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;DatasetBuilder.build(): control flow&lt;/b&gt;&lt;br&gt;&lt;i&gt;Mode is fixed in __init__; build() dispatches to one of six private builders (three modes x two targets)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="read" value="pd.read_csv(image_index)&lt;br&gt;empty file -&amp;gt; ValueError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="100.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="cols" value="require timestamp; require&lt;br&gt;active_region if&lt;br&gt;target=&quot;active_region&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="190.0" width="250.0" height="70.0" as="geometry"/></mxCell><mxCell id="em" value="EventMatcher(catalog)&lt;br&gt;schema + GOES class check, sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="290.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="warn" value="AR mode: warn if catalog&lt;br&gt;flares have no active_region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="380.0" width="250.0" height="70.0" as="geometry"/></mxCell><mxCell id="mode" value="&lt;b&gt;Which mode?&lt;/b&gt;&lt;br&gt;time-based params?&lt;br&gt;sequence_length &amp;gt; 1?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="330.0" y="250.0" width="180.0" height="90.0" as="geometry"/></mxCell><mxCell id="single" value="&lt;b&gt;Single image&lt;/b&gt;&lt;br&gt;_build_single_image[_active_region]&lt;br&gt;one record per index row&lt;br&gt;t = image time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560.0" y="100.0" width="270.0" height="110.0" as="geometry"/></mxCell><mxCell id="rowseq" value="&lt;b&gt;Row-based sequences&lt;/b&gt;&lt;br&gt;index sorted + unique, else error&lt;br&gt;rows[i : i+length], i += stride&lt;br&gt;skip if cadence_minutes violated&lt;br&gt;t = last image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560.0" y="240.0" width="270.0" height="130.0" as="geometry"/></mxCell><mxCell id="timeseq" value="&lt;b&gt;Time-based sequences&lt;/b&gt;&lt;br&gt;unique timestamps; infer source&lt;br&gt;cadence (most common gap); grid&lt;br&gt;start + k*cadence; skip if any grid&lt;br&gt;time missing; start += sliding_window&lt;br&gt;t = last image; SequenceBuildReport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560.0" y="400.0" width="270.0" height="160.0" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;For every reference t:&lt;/b&gt;&lt;br&gt;matcher.query(t,&lt;br&gt;prediction_window,&lt;br&gt;active_region, event_time,&lt;br&gt;interval_mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880.0" y="240.0" width="250.0" height="110.0" as="geometry"/></mxCell><mxCell id="label" value="strategy.label(flares) -&amp;gt; label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880.0" y="400.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="df" value="pd.DataFrame(records)[columns]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880.0" y="500.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;target=&quot;active_region&quot; variants of every mode&lt;/b&gt;&lt;br&gt;normalize region (13600 / 13600.0 / &quot;13600&quot; -&amp;gt; &quot;13600&quot;); query only that region's flares&lt;br&gt;sequences: group rows by region first (_region_groups); checks and grids run per region&lt;br&gt;image region missing -&amp;gt; missing_active_region: &quot;negative&quot; (+UserWarning, own group) / &quot;drop&quot; / &quot;error&quot;&lt;br&gt;time-based: source cadence from all images; one grid per region; report.region_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="600.0" width="790.0" height="140.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="read" target="cols"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="cols" target="em"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="em" target="warn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="warn" target="mode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="mode" target="single"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="mode" target="rowseq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="mode" target="timeseq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="single" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="rowseq" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="timeseq" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="query" target="label"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="label" target="df"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 Time windows"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Prediction window semantics&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which flares count for an image at time t (w = prediction_window). Times are compared as given (no TAI/UTC conversion).&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="axis" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="234.0" y="140.0" width="572.0" height="3.0" as="geometry"/></mxCell><mxCell id="tm24" value="t - 24h" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="234.0" y="108.0" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="t" value="t" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="512.0" y="108.0" width="30.0" height="24.0" as="geometry"/></mxCell><mxCell id="t24" value="t + 24h" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="762.0" y="108.0" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="legend" value="filled dot = included, ring = excluded" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="152.0" width="220.0" height="24.0" as="geometry"/></mxCell><mxCell id="left_txt" value="[t, t+w)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="200.0" width="210.0" height="30.0" as="geometry"/></mxCell><mxCell id="left_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520.0" y="204.0" width="264.0" height="22.0" as="geometry"/></mxCell><mxCell id="left_l" value="●" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="511.0" y="200.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="left_r" value="○" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775.0" y="200.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="left_desc" value="interval_mode=&quot;left_closed&quot; (package default)&lt;br&gt;includes t, excludes t + w" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="806.0" y="194.0" width="334.0" height="42.0" as="geometry"/></mxCell><mxCell id="right_txt" value="(t, t+w]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="270.0" width="210.0" height="30.0" as="geometry"/></mxCell><mxCell id="right_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520.0" y="274.0" width="264.0" height="22.0" as="geometry"/></mxCell><mxCell id="right_l" value="○" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="511.0" y="270.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="right_r" value="●" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775.0" y="270.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="right_desc" value="interval_mode=&quot;right_closed&quot; (lab full-disk)&lt;br&gt;excludes t, includes t + w" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="806.0" y="264.0" width="334.0" height="42.0" as="geometry"/></mxCell><mxCell id="legacy_txt" value="(t, t+23:59:59]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="340.0" width="210.0" height="30.0" as="geometry"/></mxCell><mxCell id="legacy_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520.0" y="344.0" width="264.0" height="22.0" as="geometry"/></mxCell><mxCell id="legacy_l" value="○" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="511.0" y="340.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="legacy_r" value="●" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775.0" y="340.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="legacy_desc" value="prediction_window=&quot;23h59min59s&quot;&lt;br&gt;reproduces labeling.py (full disk) exactly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="806.0" y="334.0" width="334.0" height="42.0" as="geometry"/></mxCell><mxCell id="lookback_txt" value="[t-24h, t]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="410.0" width="210.0" height="30.0" as="geometry"/></mxCell><mxCell id="lookback_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="256.0" y="414.0" width="264.0" height="22.0" as="geometry"/></mxCell><mxCell id="lookback_l" value="●" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="247.0" y="410.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="lookback_r" value="●" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="511.0" y="410.0" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="lookback_desc" value="published arpatch-sfp AR labels&lt;br&gt;(step3_labeling.py); NOT supported, see D2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="806.0" y="404.0" width="334.0" height="42.0" as="geometry"/></mxCell><mxCell id="ev" value="event_time selects the flare time that must fall inside the window:&lt;br&gt;  &quot;peak&quot; (default) -&amp;gt; peak_time&lt;br&gt;  &quot;start&quot; -&amp;gt; start_time (lab convention)&lt;br&gt;Sequences: t = sequence_end (last image of the sequence)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="500.0" width="520.0" height="110.0" as="geometry"/></mxCell><mxCell id="ex" value="Example from the real full-disk data (2010-2018, 63,649 images):&lt;br&gt;image 2014-08-23 12:00, M5.9 flare starts 2014-08-24 12:00 (= t + 24h)&lt;br&gt;  (t, t+24h]       -&amp;gt; label 1&lt;br&gt;  (t, t+23:59:59]  -&amp;gt; label 0 (legacy)&lt;br&gt;Six images differ this way; with 23h59min59s all 63,649 agree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="590.0" y="500.0" width="550.0" height="130.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 Sequences"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Sequence construction&lt;/b&gt;&lt;br&gt;&lt;i&gt;Row-based uses positions in the index; time-based uses an exact timestamp grid and skips incomplete grids&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="rb_title" value="Row-based: sequence_length=3, stride=3, cadence_minutes=60 (index must be sorted and unique)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="95.0" width="1100.0" height="30.0" as="geometry"/></mxCell><mxCell id="rb0" value="row 0&lt;br&gt;00:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60.0" y="130.0" width="90.0" height="40.0" as="geometry"/></mxCell><mxCell id="rb1" value="row 1&lt;br&gt;01:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="170.0" y="130.0" width="90.0" height="40.0" as="geometry"/></mxCell><mxCell id="rb2" value="row 2&lt;br&gt;02:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="280.0" y="130.0" width="90.0" height="40.0" as="geometry"/></mxCell><mxCell id="rb3" value="row 3&lt;br&gt;03:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390.0" y="130.0" width="90.0" height="40.0" as="geometry"/></mxCell><mxCell id="rb4" value="row 4&lt;br&gt;04:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;ali