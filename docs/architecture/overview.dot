// flare-indexer architecture at commit 7e1de6c.
// Generated by docs/architecture/make_overview.py; edit NODES/EDGES there, not this file.
// Render: dot -Tpdf overview.dot -o figure.pdf (or -Tsvg). Graphviz chooses its own layout,
// so the result is arranged differently from the shipped overview.pdf/.svg; the content is the same.
// Box kinds: note + dashed = external data; rounded box = package component;
// bold = entry point; dotted green = framework example outside the package.
digraph flare_indexer {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, nodesep=0.35, ranksep=0.8,
         label="flare-indexer: from an observation index and a flare catalog to labeled samples (commit 7e1de6c)"];
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8];

  raw [label="Raw sources  (optional)\nHMI / SHARP image file names\nlab GOES catalog (goes_flares_integrated)", shape=note, style="dashed,filled", fillcolor="#f5f5f5", color="#666666"];
  loaders [label="Input adapters  (loaders, optional)\nbuild_image_index_from_filenames\nadapt_goes_catalog", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
  index [label="Observation index  (CSV)\ntimestamp\n[active_region]  [image_path, ids]", shape=note, style="dashed,filled", fillcolor="#f5f5f5", color="#666666"];
  catalog [label="Flare catalog  (CSV)\nstart_time, peak_time, end_time\nclass, active_region", shape=note, style="dashed,filled", fillcolor="#f5f5f5", color="#666666"];
  api [label="Python API\nDatasetBuilder(window, strategy, target, ...)\n.build(index_csv, catalog_csv)", shape=box, style="rounded,filled,bold", fillcolor="#fff3d1", color="#8a5a00"];
  cli [label="Command line\nflare-indexer label IMAGES.csv CATALOG.csv\n  --output OUT.csv [options]", shape=box, style="rounded,filled,bold", fillcolor="#fff3d1", color="#8a5a00"];
  builder [label="DatasetBuilder  (builder): sample construction\ntarget:  full_disk  |  active_region  (region from the index column)\nmode:    single image  |  row-based sequence  |  time-based sequence (grid, report)\nper sample: reference time t = the image, or the last image of the sequence;\n            window (t, t+w);  one row per image or sequence", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
  matcher [label="EventMatcher  (events)\nloads and validates the catalog\nquery(t, window, region,\n      event_time)  window (t, t+w)\n→ list[FlareEvent] in the window", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
  classifier [label="classifier\nFluxConverter: GOES class ↔ flux (decimal)\nGOES class validation", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
  output [label="Output table  (pandas DataFrame; CSV from the CLI)\nsingle image:  timestamp [active_region] label [image_path, ids]\nsequence:      sequence_start, sequence_end, timestamps,\n               n_images [active_region] label [image_path, ids]\nCLI writes CSV; list and dict cells as JSON text", shape=note, style="dashed,filled", fillcolor="#f5f5f5", color="#666666"];
  torch [label="PyTorch examples 07, 08\nDataset / DataLoader\n[B,C,H,W]  [B,T,C,H,W]", shape=box, style="rounded,dotted,filled", fillcolor="#eaf6ea", color="#2e6b2e"];
  tf [label="TensorFlow examples 10, 11\ntf.data.Dataset\n[B,H,W,C]  [B,T,H,W,C]", shape=box, style="rounded,dotted,filled", fillcolor="#eaf6ea", color="#2e6b2e"];

  subgraph cluster_strategy {
    label="strategy.label(events)  =  reducer.reduce(events)  →  labeler.assign(value)      (strategies, pipeline)\nready-made:  BinaryThresholdStrategy = MaxFlux + BinaryThreshold;   MaxFlareStrategy = MaxFlux + Regression\nany pair:    DatasetBuildingPipeline(reducer, labeler);   any object with .label(events) is accepted as strategy";
    fontsize=9; color="#1f4e79"; style=rounded;
    red_flux [label="MaxFluxReducer  /  MinFluxReducer\n→ flux of the strongest / weakest\n   event in W/m²  (0.0 if none)", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    lab_flux [label="flux  →  label\nBinaryThresholdLabeler(GOES class) → 0 / 1\nRegressionLabeler → flux value\nMulticlassLabeler → NF / A / B / C / M / X", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    lab_cum [label="index  →  label\nNumericThresholdLabeler(number) → 0 / 1\nRegressionLabeler → raw index", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    lab_count [label="counts  →  label\nClassCountLabeler → counts dict\nClassPresenceLabeler → 0 / 1 per class", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    red_cum [label="CumulativeClassIndexReducer\n→ Σ C + 10 Σ M + 100 Σ X\n  C, M, X: GOES subclass values, not event counts\n  e.g. C2.5 + M1.2 = 2.5 + 10 × 1.2 = 14.5;  A, B add 0", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    red_count [label="ClassCountReducer\n→ counts per class {A, B, C, M, X}", shape=box, style="rounded,filled", fillcolor="#e8f0fa", color="#1f4e79"];
    { rank=same; red_flux; red_count; red_cum; }
    { rank=same; lab_flux; lab_count; lab_cum; }
  }

  { rank=same; raw; loaders; }
  { rank=same; index; catalog; }
  { rank=same; api; cli; }
  { rank=same; builder; matcher; classifier; }
  { rank=same; output; torch; tf; }

  raw -> loaders [style=solid, color="#333333"];
  loaders -> index [style=solid, color="#333333", label="writes"];
  loaders -> catalog [style=solid, color="#333333", label="writes"];
  index -> builder [style=solid, color="#333333"];
  catalog -> matcher [style=solid, color="#333333"];
  cli -> api [style=dashed, color="#8a5a00", label="builds + calls"];
  api -> builder [style=solid, color="#333333"];
  builder -> matcher [style=solid, color="#333333", label="t, window, region"];
  matcher -> red_flux [style=solid, color="#333333", label="events"];
  matcher -> red_count [style=solid, color="#333333", label="events"];
  matcher -> red_cum [style=solid, color="#333333", label="events"];
  red_flux -> lab_flux [style=solid, color="#333333", label="flux"];
  red_count -> lab_count [style=solid, color="#333333", label="counts"];
  red_cum -> lab_cum [style=solid, color="#333333", label="index"];
  lab_flux -> builder [style=solid, color="#333333", label="label per sample"];
  builder -> output [style=solid, color="#333333", label="labeled rows"];
  output -> torch [style=solid, color="#333333"];
  output -> tf [style=solid, color="#333333"];
  classifier -> matcher [style=dotted, color="#1f4e79", arrowhead=open, label="class validation"];
  classifier -> red_flux [style=dotted, color="#1f4e79", arrowhead=open, label="GOES class ↔ flux"];
  classifier -> lab_flux [style=dotted, color="#1f4e79", arrowhead=open];
}
