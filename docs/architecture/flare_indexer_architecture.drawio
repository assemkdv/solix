" parent="1"><mxGeometry x="800.0" y="360.0" width="200.0" height="70.0" as="geometry"/></mxCell><mxCell id="classifier" value="classifier.py&lt;br&gt;FluxConverter, FlareClassifier,&lt;br&gt;InvalidGOESClassError, parse_goes_class" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640.0" y="500.0" width="280.0" height="70.0" as="geometry"/></mxCell><mxCell id="deps" value="pandas, numpy (only runtime deps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="160.0" y="500.0" width="300.0" height="60.0" as="geometry"/></mxCell><mxCell id="scripts" value="&lt;b&gt;Scripts, examples, committed results&lt;/b&gt;&lt;br&gt;scripts/validate_full_disk.py -&amp;gt; real full-disk data vs legacy labels&lt;br&gt;scripts/validate_active_region.py -&amp;gt; published AR labels (HARP key)&lt;br&gt;examples/01..06_*.py + examples/data (synthetic)&lt;br&gt;docs/validation/*.json, *.txt (committed results)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="620.0" width="520.0" height="120.0" as="geometry"/></mxCell><mxCell id="tests" value="&lt;b&gt;tests/ (pytest, CI on Python 3.10-3.13)&lt;/b&gt;&lt;br&gt;unit: events, builder, loaders, strategies, pipeline, ...&lt;br&gt;test_windows_and_missing_regions.py: duration windows, AR policy&lt;br&gt;test_active_region_grouping.py, test_goes_class_validation.py&lt;br&gt;test_examples.py: every example runs; sample data regenerates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600.0" y="620.0" width="530.0" height="120.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=1;fontSize=