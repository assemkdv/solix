y="180.0" width="310.0" height="28.0" as="geometry"/></mxCell><mxCell id="rbnote" value="Without cadence_minutes, seq 3 would be kept although its images are not 60 min apart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="218.0" width="970.0" height="32.0" as="geometry"/></mxCell><mxCell id="tb_title" value="Time-based: cadence=&quot;2h&quot;, observation_window=&quot;6h&quot; (3 images), sliding_window=&quot;2h&quot;; inferred source cadence = 1h" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30.0" y="275.0" width="1100.0" height="30.0" as="geometry"/></mxCell><mxCell id="tb0" value="00:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb1" value="01:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="148.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb2" value="02:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="236.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb3" value="03:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="324.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb4" value="04:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="412.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb5" value="05:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="500.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb6" value="06:00&lt;br&gt;missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="588.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb7" value="07:00&lt;br&gt;missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="676.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb8" value="08:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="764.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb9" value="09:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="852.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb10" value="10:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="tb11" value="11:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1028.0" y="310.0" width="76.0" height="40.0" as="geometry"/></mxCell><mxCell id="g1" value="00:00 -&amp;gt; 00, 02, 04: emitted, t = 04:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60.0" y="362.0" width="428.0" height="30.0" as="geometry"/></mxCell><mxCell id="g2" value="02:00 -&amp;gt; 02, 04, 06: 06:00 missing, skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="236.0" y="400.0" width="428.0" height="30.0" as="geometry"/></mxCell><mxCell id="g3" value="04:00 -&amp;gt; 04, 06, 08: skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="412.0" y="438.0" width="428.0" height="30.0" as="geometry"/></mxCell><mxCell id="g4" value="06:00 -&amp;gt; 06, 08, 10: skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="588.0" y="476.0" width="428.0" height="30.0" as="geometry"/></mxCell><mxCell id="g5" value="08:00 -&amp;gt; needs 12:00 &amp;gt; last image: stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="764.0" y="514.0" width="376.0" height="30.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Rules (builder._grid_candidates and its callers)&lt;/b&gt;&lt;br&gt;cadence &amp;gt;= inferred cadence and an exact multiple of it&lt;br&gt;observation_window, sliding_window: multiples of cadence&lt;br&gt;start (optional) must be an existing image time&lt;br&gt;candidates while start + observation_window - cadence &amp;lt;= last image&lt;br&gt;missing grid time -&amp;gt; skip; never interpolate or substitute&lt;br&gt;return_report=True -&amp;gt; SequenceBuildReport (counts, first 50 skips)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="570.0" width="560.0" height="180.0" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Output row per emitted sequence&lt;/b&gt;&lt;br&gt;sequence_start, sequence_end, timestamps (list), n_images,&lt;br&gt;[active_region], label, + every other index column as a list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="650.0" y="570.0" width="480.0" height="90.0" as="geometry"/></mxCell><mxCell id="arseq" value="&lt;b&gt;target=&quot;active_region&quot;: all of the above runs per region;&lt;/b&gt;&lt;br&gt;regions may share timestamps; a gap affects only its own region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="650.0" y="675.0" width="480.0" height="75.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5 Active regions"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Active-region matching and missing data&lt;/b&gt;&lt;br&gt;&lt;i&gt;target=&quot;active_region&quot;: a flare counts only if its region key equals the patch's region key&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="patch" value="Patch row&lt;br&gt;timestamp, active_region,&lt;br&gt;image_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="110.0" width="230.0" height="80.0" as="geometry"/></mxCell><mxCell id="norm" value="_normalize_active_region()&lt;br&gt;13600 / 13600.0 / &quot;13600&quot; -&amp;gt; &quot;13600&quot;&lt;br&gt;blank -&amp;gt; None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="320.0" y="110.0" width="230.0" height="80.0" as="geometry"/></mxCell><mxCell id="missing_q" value="&lt;b&gt;image region&lt;/b&gt;&lt;br&gt;missing?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600.0" y="100.0" width="230.0" height="100.0" as="geometry"/></mxCell><mxCell id="policy" value="&lt;b&gt;missing_active_region&lt;/b&gt;&lt;br&gt;&quot;negative&quot; (default): label as no&lt;br&gt;flare + UserWarning&lt;br&gt;&quot;drop&quot;: leave out&lt;br&gt;&quot;error&quot;: ValueError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880.0" y="90.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="query" value="EventMatcher.query(t, w,&lt;br&gt;active_region=region)&lt;br&gt;candidates in window, then&lt;br&gt;filter catalog region == region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600.0" y="260.0" width="230.0" height="90.0" as="geometry"/></mxCell><mxCell id="catmiss" value="Catalog flare without region:&lt;br&gt;never matches any patch&lt;br&gt;(UserWarning with count)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880.0" y="260.0" width="250.0" height="90.0" as="geometry"/></mxCell><mxCell id="seq" value="Sequences: rows grouped by region first; each region's sequences&lt;br&gt;use only its images; unique timestamps required within a region.&lt;br&gt;Rows without a region never join a region's sequence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="260.0" width="510.0" height="90.0" as="geometry"/></mxCell><mxCell id="label" value="strategy.label(flares)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600.0" y="400.0" width="230.0" height="60.0" as="geometry"/></mxCell><mxCell id="mapping" value="&lt;b&gt;Region keys in the lab data&lt;/b&gt;&lt;br&gt;patch: SHARP filename -&amp;gt; HARP number (e.g. 362)&lt;br&gt;flare: goes_flares_integrated.csv -&amp;gt; NOAA number (e.g. 11153)&lt;br&gt;allharp2noaa.csv: many-to-many (&amp;lt;= 6 NOAA per HARP, &amp;lt;= 2 HARP per NOAA)&lt;br&gt;-&amp;gt; build a HARP-keyed catalog (scripts/validate_active_region.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40.0" y="400.0" width="510.0" height="150.0" as="geometry"/></mxCell><mxCell id="facts" value="&lt;b&gt;Published-label facts (lab catalog + arpatch-sfp folds)&lt;/b&gt;&lt;br&gt;- 2,343 of 14,401 flares have no NOAA region (33 of 792 M/X)&lt;br&gt;- 108 flares have a NOAA region with no HARP&lt;br&gt;- 511,421 published patches (-90..90 folds); up to 22 per timestamp&lt;br&gt;- look-back [t-1 day, t] reproduces label + goes_class: 100 %&lt;br&gt;- package forward (t, t+24h]: 97.573 % label agreement&lt;br&gt;- catalog coverage is not stated in the catalog&lt;br&gt;Each gap can cause false negatives; affected rows are unknown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600.0" y="500.0" width="530.0" height="230.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="patch" target="norm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="norm" target="missing_q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="yes" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="missing_q" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="no" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="missing_q" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;dashed=1;" edge="1" parent="1" source="catmiss" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="query" target="label"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 Modules and tests"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Package modules, dependencies and verification&lt;/b&gt;&lt;br&gt;&lt;i&gt;src/flare_indexer/* (public API re-exported from __init__.py); arrows point from user to dependency&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1109" height="60" as="geometry"/></mxCell><mxCell id="init" value="__init__.py&lt;br&gt;public API (19 names)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="460.0" y="90.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="builder" value="builder.py&lt;br&gt;DatasetBuilder, SequenceBuildReport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;